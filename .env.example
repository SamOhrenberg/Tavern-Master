# Tavern Master configuration. Copy to `.env` and edit.
# Every setting is an environment variable; nothing is configured in files.
# Lines marked REQUIRED must be changed before the first start.

###############################################################################
# Secrets — REQUIRED
###############################################################################
# Signs CSRF tokens and internal service calls. 32+ random characters.
#   openssl rand -base64 48
SECRET_KEY=

# Encrypts stored secrets at rest (users' own API keys, TOTP secrets).
# 32+ random characters, different from SECRET_KEY. If you lose this, stored
# BYO keys and 2FA enrolments cannot be decrypted (users re-enter them).
ENCRYPTION_KEY=

# Password for the bundled PostgreSQL. Use letters and digits only: it is
# placed inside a connection URL.
POSTGRES_PASSWORD=

###############################################################################
# First administrator
###############################################################################
# Created on first start if the database has no users. If ADMIN_PASSWORD is
# empty, a one-time admin invite code is printed to the web container's log
# instead (docker compose logs web).
ADMIN_USERNAME=admin
# 12+ characters. You can blank this again after the first start.
ADMIN_PASSWORD=
# Admins must enrol TOTP 2FA before admin pages work. Keep this on for any
# instance reachable from the internet.
ADMIN_REQUIRE_TOTP=true

###############################################################################
# URL, ports and reverse proxy
###############################################################################
# The public URL users type into the browser. Decides cookie "Secure", HSTS,
# the CSRF origin check and the websocket CSP entry. No trailing slash.
BASE_URL=http://localhost:8080

# Host interface and port the web container is published on.
#   127.0.0.1 = this machine only (a reverse proxy on the host can reach it)
#   0.0.0.0   = reachable from your LAN
APP_BIND=127.0.0.1
APP_PORT=8080

# IPs or CIDR ranges of reverse proxies whose X-Forwarded-For / -Proto headers
# may be trusted, comma separated. Leave EMPTY when nothing sits in front.
# Typical: the Docker network your proxy uses, e.g. 172.18.0.0/16
# Rate limiting and audit logs use the client IP derived from this.
TRUSTED_PROXIES=

# Extra browser origins allowed to call the API (comma separated). Normally
# empty: the app is same-origin. Dev only: http://localhost:5173
CORS_ALLOWED_ORIGINS=

###############################################################################
# Docker / compose
###############################################################################
# Image to run. Leave as is to pull from GHCR, or build locally with
# `docker compose build`.
TAVERN_IMAGE=ghcr.io/samohrenberg/tavern-master:latest

# Claude on call: a container that brings Claude Code to a table when players
# sit down. Uncomment to turn it on, then fill in .env.dm-launcher (copy
# .env.dm-launcher.example). See "Claude on call" in the README.
# COMPOSE_PROFILES=claude
# DM_LAUNCHER_IMAGE=ghcr.io/samohrenberg/tavern-master-dm-launcher:latest

# Only with docker/compose.proxy.example.yml: the reverse proxy's Docker
# network to join instead of publishing a port (`docker network ls`).
PROXY_NETWORK=

# User and group the app containers run as (like PUID/PGID on linuxserver.io
# images). With bind mounts, chown the host folders to this uid:gid.
PUID=1000
PGID=1000

# Storage. A bare name is a Docker named volume; a path is a bind mount.
PGDATA_PATH=pgdata
UPLOADS_PATH=uploads
MODELS_PATH=models

# Memory limits per container.
WEB_MEM_LIMIT=384m
WORKER_MEM_LIMIT=1g
DB_MEM_LIMIT=512m
PG_SHARED_BUFFERS=64MB

POSTGRES_USER=tavern
POSTGRES_DB=tavern

###############################################################################
# Accounts and sessions
###############################################################################
# false = registration needs an admin-issued invite code (recommended).
OPEN_REGISTRATION=false
# A session ends after this long without activity, or at the hard limit.
SESSION_IDLE_HOURS=72
SESSION_MAX_DAYS=30
# Consecutive failed logins before an account is locked, and for how long.
LOGIN_LOCKOUT_THRESHOLD=8
LOGIN_LOCKOUT_MINUTES=15

###############################################################################
# Rate limits (per client IP; LLM limit is also per user)
###############################################################################
# Login, registration, invite redemption, 2FA attempts: per 15 minutes.
RATE_LIMIT_AUTH_PER_15M=20
# All other API calls: per minute.
RATE_LIMIT_API_PER_MIN=300
# Player actions that can trigger the DM: per minute.
RATE_LIMIT_LLM_PER_MIN=20

###############################################################################
# LLM provider
###############################################################################
# anthropic | bedrock | foundry | openai | mock
#   anthropic  Anthropic API (recommended; simplest setup)
#   bedrock    Claude on AWS Bedrock
#   foundry    Claude on Azure AI Foundry
#   openai     any OpenAI-compatible endpoint (OpenAI, OpenRouter, Azure
#              OpenAI v1, Ollama, Gemini's compatibility endpoint)
#   mock       scripted DM, no API calls — for trying the stack out
#   none       no built-in AI at all: every campaign is run by its owner's
#              Claude through the connector, and no API key is needed
LLM_PROVIDER=anthropic

# Model per task. Narration runs the DM; utility writes summaries and memory.
# On Bedrock prefix Claude ids with "anthropic." (anthropic.claude-opus-5-5).
LLM_MODEL_NARRATION=claude-sonnet-5-5
LLM_MODEL_UTILITY=claude-haiku-5-5
# Two more tasks, each optional. A companion with an AI of its own acts once
# per turn in a sentence or two; the character-building guide chats with one
# player. Empty uses the narration model for both. A small model (e.g. Haiku)
# is cheaper but plays companions noticeably worse.
LLM_MODEL_COMPANION=
LLM_MODEL_PREP=
# Reasoning effort for Claude models: low | medium | high | xhigh | max
LLM_EFFORT_NARRATION=medium
LLM_EFFORT_UTILITY=low
# Hard cap on tokens generated per model call (thinking + text).
LLM_MAX_OUTPUT_TOKENS=16000

# --- anthropic ---
ANTHROPIC_API_KEY=
# If a Claude model declines a request for safety reasons, let the API retry it
# on a fallback model automatically. default | off
ANTHROPIC_REFUSAL_FALLBACK=default
# How long the Anthropic API keeps the DM's prompt prefix cached: 5m | 1h.
# Cached input costs a tenth of the normal price. 5m suits a table that acts
# every few minutes. Choose 1h if turns are often more than five minutes apart
# (play-by-post, slow evenings): writing the cache costs more, but it is still
# there when the next turn arrives. Anthropic API only.
LLM_CACHE_TTL=5m

# --- bedrock ---
AWS_REGION=
# Either a Bedrock API key ...
AWS_BEARER_TOKEN_BEDROCK=
# ... or IAM credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- foundry ---
# Resource name from https://<resource>.services.ai.azure.com
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=

# --- openai-compatible ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Optional price overrides for cost estimates, USD per million tokens:
# {"my-model":{"input":1,"output":5,"cacheRead":0.1,"cacheWrite":1.25}}
LLM_PRICES_JSON=

###############################################################################
# Embeddings (rules search)
###############################################################################
# local  = small CPU model inside the worker container; free, private
# openai = OpenAI-compatible /embeddings endpoint
# none   = keyword search only
EMBEDDING_PROVIDER=local
# local: a Hugging Face ONNX model id, downloaded once to the models volume.
# openai: e.g. text-embedding-3-small
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=

###############################################################################
# Uploads and parsing
###############################################################################
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=1500
# A document that takes longer or needs more memory than this is rejected.
PARSE_TIMEOUT_SECONDS=180
PARSE_MEMORY_MB=512
# Documents a single campaign may hold (setting, adventure, house rules).
MAX_CAMPAIGN_DOCUMENTS=20

###############################################################################
# DM agent
###############################################################################
# Maximum tool-calling rounds in one DM turn.
AGENT_MAX_TOOL_ROUNDS=8
# Summarise older messages once the unsummarised history passes this size,
# always keeping the most recent messages verbatim.
SUMMARY_TRIGGER_TOKENS=6000
SUMMARY_KEEP_MESSAGES=8
# The DM's brief (notebook, facts, story so far) is compiled once and cached.
# Notes written afterwards are sent alongside it; once they pass this many
# tokens the brief is compiled again.
BRIEF_REFRESH_TOKENS=1200
# Long campaigns: past this many session summaries the older half is merged
# into one "arc", and past this many durable notes the list is tidied.
ARC_AFTER_SESSIONS=10
MEMORY_CONSOLIDATE_AT=40
# Default seconds to wait for other players' actions before the DM answers.
DEFAULT_GATHER_WINDOW_SECONDS=60
# For campaigns run from the Claude app (the connector at BASE_URL/mcp): minutes
# a gathered turn waits for the Claude app before it is handed back to the table.
CONNECTOR_TURN_TIMEOUT_MINUTES=120
# The longest a single wait_for_work call from Claude blocks, in seconds.
# Raise it only if your reverse proxy's read timeout is higher than this.
CONNECTOR_MAX_WAIT_SECONDS=50
# A turn or request Claude took and then left alone this many minutes goes
# back to waiting, and players see that Claude is away.
CONNECTOR_CLAIM_TIMEOUT_MINUTES=10
# With no players connected and nothing to do for this many minutes, Claude is
# told to stop polling until someone comes back.
CONNECTOR_IDLE_MINUTES=10
# The largest photo of a character sheet handed to Claude to read, in bytes.
CONNECTOR_IMAGE_MAX_BYTES=3000000
# Signing in from Claude: minutes an access token lasts before Claude quietly
# refreshes it, and days an unused connection stays signed in.
OAUTH_ACCESS_TOKEN_MINUTES=60
OAUTH_REFRESH_TOKEN_DAYS=90

###############################################################################
# Budgets — tokens per rolling 24 hours, 0 = unlimited
###############################################################################
# Stops a runaway loop or a compromised account from running up the bill.
# About 0.75M tokens are processed per hour of fast play.
USER_DAILY_TOKEN_BUDGET=8000000
CAMPAIGN_DAILY_TOKEN_BUDGET=6000000

###############################################################################
# Feedback — the in-app feedback button
###############################################################################
# Bug reports, ideas and feedback sent from the app become GitHub issues on
# this repository, and players can follow their status and replies in the
# app. Make a fine-grained token limited to this one repository with
# "Issues: Read and write" (Metadata: read is added automatically). Leave
# either empty to hide the button. Attached screenshots and photos stay on
# this server; the issue links to them, and only admins (and whoever sent
# them) can open those links.
GITHUB_FEEDBACK_REPO=
GITHUB_FEEDBACK_TOKEN=

###############################################################################
# Push notifications
###############################################################################
# Players turn notifications on in the app (You, Notifications). They need
# HTTPS, and on iPhone the app added to the Home Screen. The key pair push
# services know this server by is made on first start and kept in the
# database: leave both keys empty unless you are moving an existing pair over.
# Changing it signs every device out of notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# How push services can reach whoever runs this server: an https: URL or a
# mailto: address. Empty uses BASE_URL when it is https.
VAPID_SUBJECT=
# Seconds between two notifications to one person about the same campaign's
# table talk and party actions. Narration, rolls and sessions always go out.
PUSH_COOLDOWN_SECONDS=60
# Minutes a turn waits on someone before they get a "your move" nudge, once
# per turn. A gather window shorter than this closes the turn first, so it
# matters most for tables that wait until everyone is ready.
PUSH_WAITING_MINUTES=5

###############################################################################
# Logging
###############################################################################
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

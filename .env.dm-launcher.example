# The DM launcher's secrets (Claude on call). Copy to `.env.dm-launcher`.
# Only the dm-launcher container reads this file; the web and worker never see it.
# Turn the launcher on with COMPOSE_PROFILES=claude in .env.

# A Tavern Master token, from the app: You → Claude → Use a token instead.
# With or without the "Bearer " in front.
TAVERN_TOKEN=

# Claude Code's sign-in. On any computer with Claude Code, run
#   claude setup-token
# then uncomment the line below and paste the token it prints (it lasts about a
# year, and uses your Claude plan). Or leave it commented out and sign in inside
# the container instead, once; the sign-in is kept in the dm-home volume:
#   docker compose run --rm dm-launcher claude     then type /login
# CLAUDE_CODE_OAUTH_TOKEN=

# Optional: stop a run after this many minutes with nobody at the table, or
# with no word from Claude while players wait (default 15).
# TAVERN_IDLE_MINUTES=15
